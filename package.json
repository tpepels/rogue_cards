{
  "name": "rogue-cards",
  "version": "1.0.0-tabletop",
  "private": true,
  "type": "module",
  "description": "Physical-first d20/d6 Rogue Cards print-and-play tabletop game",
  "scripts": {
    "test": "node --test tests/tabletop.test.mjs tests/playtest.test.mjs tests/card-audit.test.mjs tests/expedition-full.test.mjs tests/balance-report.test.mjs tests/balance-experiments.test.mjs tests/warden-balance.test.mjs tests/card-interactions.test.mjs tests/card-balance.test.mjs tests/balance-adjustments.test.mjs tests/item-contracts.test.mjs tests/game-verification.test.mjs tests/post-hp-study.test.mjs tests/study-decisions.test.mjs tests/planner.test.mjs tests/card-copy.test.mjs tests/human-card-usability.test.mjs tests/ashwood-staff.test.mjs tests/item-opportunities.test.mjs tests/hero-item-balance.test.mjs tests/local-validation.test.mjs tests/research-agent.test.mjs tests/stochastic-rollout.test.mjs tests/rollout-budget-study.test.mjs",
    "test:visual": "playwright test",
    "balance": "node scripts/full-balance.mjs",
    "balance:baseline": "node scripts/playtest.mjs",
    "balance:full": "node scripts/full-balance.mjs",
    "audit": "node scripts/audit.mjs",
    "serve": "python3 -m http.server 8000",
    "balance:matched": "node scripts/analyze-balance.mjs vault",
    "balance:rooms": "node scripts/analyze-balance.mjs rooms",
    "balance:diagnostics": "node scripts/analyze-balance.mjs diagnostics",
    "balance:items": "node scripts/card-balance.mjs items",
    "balance:room-cards": "node scripts/card-balance.mjs rooms",
    "verify:items": "node --test tests/item-contracts.test.mjs tests/expedition-full.test.mjs tests/card-interactions.test.mjs",
    "verify:game": "node scripts/verify-game.mjs",
    "study:items": "node scripts/study-items.mjs",
    "study:rooms": "node scripts/post-hp-study.mjs rooms",
    "study:strategies": "node scripts/post-hp-study.mjs strategies",
    "study:decisions": "node scripts/study-decisions.mjs",
    "study:report": "node scripts/report-decisions.mjs",
    "study:planner": "node scripts/study-planner.mjs",
    "study:planner:report": "node scripts/report-planner.mjs",
    "study:planner:ablation": "node scripts/study-planner-ablation.mjs",
    "study:planner:ablation:report": "node scripts/report-planner-ablation.mjs",
    "study:items:report": "node scripts/report-items.mjs",
    "study:items:targets": "node scripts/study-item-targets.mjs",
    "study:items:targets:report": "node scripts/report-item-targets.mjs",
    "study:hero-balance": "node scripts/study-hero-balance.mjs",
    "study:hero-balance:report": "node scripts/report-hero-balance.mjs",
    "validate:local": "node scripts/validate-local.mjs",
    "agent:study": "node scripts/study-agent.mjs",
    "test:rollout": "node --test tests/research-agent.test.mjs tests/stochastic-rollout.test.mjs",
    "agent:budgets": "node scripts/study-rollout-budgets.mjs",
    "art:missing": "python3 scripts/generate-illustrations.py",
    "art:check": "python3 scripts/generate-illustrations.py --list",
    "art:test": "python3 -m unittest discover -s tests -p test_illustration_generator.py"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1"
  }
}
